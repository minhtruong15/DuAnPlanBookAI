# Cổng chạy máy chủ Backend Express
PORT=5000

# Đường dẫn kết nối Cơ sở dữ liệu MySQL 8.0 (Dùng cho Prisma ORM)
DATABASE_URL="mysql://root:123456@localhost:3306/planbookai_db"

# Khóa bí mật dùng để ký và giải mã thẻ đăng nhập JWT Token
JWT_SECRET="planbookai_super_secret_jwt_key_2026"

# Khóa API kết nối trí tuệ nhân tạo Google Gemini AI
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Cấu hình lưu trữ ảnh chụp phiếu trả lời OCR trên đám mây Supabase Storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your_supabase_anon_or_service_key"